# Backend Environment Variables
# Copy this to .env and fill in your actual values

# LLM API Keys (comma-separated, at least 2 keys)
# Examples:
#   - Groq: gsk_...,gsk_...
#   - Google Gemini: AQ...,AQ...
#   - OpenAI: sk-...,sk-...
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Optional Model Override (Defaults to groq/openai/gpt-oss-20b)
LLM_MODEL=groq/openai/gpt-oss-20b

# Database location (SQLite file path)
DATABASE_URL=sqlite:////data/app.db

# CORS allowed origins (comma-separated)
# For local development: http://localhost:3000
# For production: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# Enable failover simulation via X-Simulate-Failure header
# Set to true for testing, false for production
ENABLE_FAILURE_SIMULATION=true
